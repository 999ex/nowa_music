---
import { getCollection } from 'astro:content';
import NewsDetailPage from '../../../components/pages/NewsDetailPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('news', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<NewsDetailPage lang="en" entry={entry} />
