---
import { messages, stripLang, localePath } from '../lib/i18n.js';

const { lang = 'ja' } = Astro.props;
const m = messages[lang];
const path = stripLang(Astro.url.pathname);
const items = [
  { href: '/music/', label: m.nav.music },
  { href: '/about/', label: m.nav.about },
];
const otherLang = lang === 'ja' ? 'en' : 'ja';
const switchHref = localePath(otherLang, path);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href={localePath(lang, '/')}>
      <span class="header__logo-main">NOWA</span>
      <span class="header__logo-sub">MUSIC</span>
    </a>
    <nav class="header__nav" aria-label={m.nav.label}>
      {items.map((item) => (
        <a
          class="header__link"
          href={localePath(lang, item.href)}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="header__listen" href={localePath(lang, '/#listen')}>
        {m.nav.listen}<span class="header__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="header__lang" href={switchHref} hreflang={otherLang} lang={otherLang} aria-label={m.langSwitch.label}>
        {m.langSwitch.short}
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: var(--header-height);
    display: flex;
    align-items: center;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .header__logo {
    display: block;
    line-height: 1.15;
  }
  .header__logo-main {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.3em;
  }
  .header__logo-sub {
    display: block;
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    color: var(--text-dim);
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    color: var(--text-dim);
  }
  .header__link:hover,
  .header__link[aria-current='page'] { color: var(--accent); }
  .header__listen {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    color: var(--text);
    transition: border-color 0.4s ease, color 0.4s ease;
  }
  .header__listen:hover { border-color: var(--accent); color: var(--accent); }
  .header__arrow { font-size: 0.7em; }
  .header__lang {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    padding: 0.2rem 0.1rem;
    border-bottom: 1px solid var(--line);
  }
  .header__lang:hover { color: var(--accent); border-color: var(--accent); }

  /* スマホではLISTENの文字が詰まるので余白と字間を詰める */
  @media (max-width: 26rem) {
    .header__nav { gap: 0.6rem; font-size: 0.68rem; letter-spacing: 0.12em; }
    .header__listen { padding: 0.45rem 0.7rem; }
  }

  /* 342px未満だとロゴ・ナビが画面外にはみ出すため、ロゴ下段を隠して幅を稼ぐ。
     26remのブレークポイントは375pxも含んでしまい下段が消えるため、専用の狭いブレークポイントにする */
  @media (max-width: 21.375rem) {
    .header__logo-sub { display: none; }
  }
</style>
