---
import { messages, stripLang, localePath, LANGS, LANG_META } from '../lib/i18n.js';

const { lang = 'ja' } = Astro.props;
const m = messages[lang];
const path = stripLang(Astro.url.pathname);
const items = [
  { href: '/music/', label: m.nav.music },
  { href: '/about/', label: m.nav.about },
];
const otherLangs = LANGS.filter((l) => l !== lang);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href={localePath(lang, '/')}>
      <span class="header__logo-main">NOWA</span>
      <span class="header__logo-sub">MUSIC</span>
    </a>
    <nav class="header__nav" aria-label={m.nav.label}>
      {items.map((item) => (
        <a
          class="header__link"
          href={localePath(lang, item.href)}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="header__listen" href={localePath(lang, '/#listen')}>
        {m.nav.listen}<span class="header__arrow" aria-hidden="true">↗</span>
      </a>
      <details class="header__lang">
        <summary>{LANG_META[lang].short}</summary>
        <ul class="header__lang-list">
          {otherLangs.map((l) => (
            <li>
              <a href={localePath(l, path)} hreflang={l} lang={l}>{LANG_META[l].name}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: var(--header-height);
    display: flex;
    align-items: center;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .header__logo {
    display: block;
    line-height: 1.15;
  }
  .header__logo-main {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.3em;
  }
  .header__logo-sub {
    display: block;
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    color: var(--text-dim);
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    color: var(--text-dim);
  }
  .header__link:hover,
  .header__link[aria-current='page'] { color: var(--accent); }
  .header__listen {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    color: var(--text);
    transition: border-color 0.4s ease, color 0.4s ease;
  }
  .header__listen:hover { border-color: var(--accent); color: var(--accent); }
  .header__arrow { font-size: 0.7em; }
  .header__lang { position: relative; }
  .header__lang summary {
    display: block;
    list-style: none;
    cursor: pointer;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    padding: 0.2rem 0.1rem;
    border-bottom: 1px solid var(--line);
  }
  .header__lang summary::-webkit-details-marker { display: none; }
  .header__lang summary:hover,
  .header__lang[open] summary { color: var(--accent); border-color: var(--accent); }
  .header__lang-list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    min-width: 7rem;
    background: var(--header-bg);
    border: 1px solid var(--line);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .header__lang-list a { display: block; padding: 0.55rem 1rem; }
  .header__lang-list a:hover { color: var(--accent); }

  /* スマホではLISTENの文字が詰まるので余白と字間を詰める */
  @media (max-width: 26rem) {
    .header__nav { gap: 0.6rem; font-size: 0.68rem; letter-spacing: 0.12em; }
    .header__listen { padding: 0.45rem 0.7rem; }
  }

  /* 342px未満だとロゴ・ナビが画面外にはみ出すため、ロゴ下段を隠して幅を稼ぐ。
     26remのブレークポイントは375pxも含んでしまい下段が消えるため、専用の狭いブレークポイントにする */
  @media (max-width: 21.375rem) {
    .header__logo-sub { display: none; }
  }
</style>
