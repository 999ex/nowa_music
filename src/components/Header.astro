---
import { messages, stripLang, localePath, LANGS, LANG_META } from '../lib/i18n.js';
import { activeLinks } from '../lib/links.js';
import ServiceIcon from './ServiceIcon.astro';

const { lang = 'ja' } = Astro.props;
const m = messages[lang];
const path = stripLang(Astro.url.pathname);
const items = [
  { href: '/music/', label: m.nav.music },
  { href: '/charts/', label: m.charts.nav },
  { href: '/about/', label: m.nav.about },
];
const otherLangs = LANGS.filter((l) => l !== lang);
// 来訪のほとんどがスマホなので、どのページでも1タップで行けるよう 配信3つ と SNS2つ を常に出す
const pick = (labels) => labels.map((label) => activeLinks().find((link) => link.label === label)).filter(Boolean);
const services = pick(['Apple Music', 'Spotify', 'YouTube']);
const socials = pick(['Instagram', 'TikTok']);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href={localePath(lang, '/')}>
      <span class="header__logo-main">NOWA</span>
      <span class="header__logo-sub">MUSIC</span>
    </a>
    <nav class="header__nav" aria-label={m.nav.label}>
      {items.map((item) => (
        <a
          class="header__link"
          href={localePath(lang, item.href)}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      {services.length + socials.length > 0 && (
        <ul class="header__services">
          {[...services, ...socials].map((link, i) => (
            <li class:list={[i === services.length && i > 0 && 'header__services-sep']}>
              <a class="header__service" href={link.url} target="_blank" rel="noopener" aria-label={link.label} title={link.label} data-cta="header">
                <ServiceIcon name={link.label} size={i < services.length ? 19 : 17} />
              </a>
            </li>
          ))}
        </ul>
      )}
      <details class="header__menu">
        <summary aria-label={m.nav.label}>
          <span class="header__menu-bars" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <ul class="header__lang-list">
          {items.map((item) => (
            <li><a href={localePath(lang, item.href)}>{item.label}</a></li>
          ))}
          <li class="header__menu-sep" aria-hidden="true"></li>
          {otherLangs.map((l) => (
            <li>
              <a href={localePath(l, path)} hreflang={l} lang={l}>{LANG_META[l].name}</a>
            </li>
          ))}
        </ul>
      </details>
      <details class="header__lang">
        <summary>{LANG_META[lang].short}</summary>
        <ul class="header__lang-list">
          {otherLangs.map((l) => (
            <li>
              <a href={localePath(l, path)} hreflang={l} lang={l}>{LANG_META[l].name}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: var(--header-height);
    display: flex;
    align-items: center;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .header__logo {
    display: block;
    line-height: 1.15;
  }
  .header__logo-main {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.3em;
  }
  .header__logo-sub {
    display: block;
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    color: var(--text-dim);
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    color: var(--text-dim);
  }
  .header__link:hover,
  .header__link[aria-current='page'] { color: var(--accent); }
  /* 配信サービス3つ。文字より目に入りやすいロゴだけを並べ、押せる範囲は指で押しやすい大きさにする */
  .header__services {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0 0.25rem;
    list-style: none;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .header__service {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--text);
    transition: color 0.3s ease, transform 0.3s ease;
  }
  .header__service:hover,
  .header__service:focus-visible { color: var(--amber); transform: translateY(-1px); }
  /* 配信とSNSの間の細い区切り */
  .header__services-sep { display: flex; align-items: center; }
  .header__services-sep::before {
    content: "";
    width: 1px;
    height: 1.1rem;
    margin: 0 0.2rem;
    background: var(--line);
  }

  /* スマホ用メニュー（PCでは出さない） */
  .header__menu { position: relative; display: none; }
  .header__menu summary {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.6rem;
    list-style: none;
    cursor: pointer;
  }
  .header__menu summary::-webkit-details-marker { display: none; }
  .header__menu-bars { display: grid; gap: 5px; width: 18px; }
  .header__menu-bars span { display: block; height: 1px; background: var(--text); }
  .header__menu[open] .header__menu-bars span { background: var(--accent); }
  .header__menu-sep { height: 1px; margin: 0.35rem 1rem; background: var(--line); }
  .header__lang { position: relative; }
  .header__lang summary {
    display: block;
    list-style: none;
    cursor: pointer;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    padding: 0.2rem 0.1rem;
    border-bottom: 1px solid var(--line);
  }
  .header__lang summary::-webkit-details-marker { display: none; }
  .header__lang summary:hover,
  .header__lang[open] summary { color: var(--accent); border-color: var(--accent); }
  .header__lang-list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    min-width: 7rem;
    background: var(--header-bg);
    border: 1px solid var(--line);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .header__lang-list a { display: block; padding: 0.55rem 1rem; }
  .header__lang-list a:hover { color: var(--accent); }

  /* スマホでは MUSIC・ABOUT・言語をメニューに畳み、ロゴのボタン5つを並べる */
  @media (max-width: 47.99rem) {
    .header__link,
    .header__lang { display: none; }
    .header__menu { display: block; }
    .header__nav { gap: 0.25rem; }
    .header__services { padding: 0 0.15rem; gap: 0; border-left: none; }
    .header__service { width: 2.35rem; height: 2.6rem; }
  }

  /* 342px未満だとロゴ・ナビが画面外にはみ出すため、ロゴ下段を隠して幅を稼ぐ。
     26remのブレークポイントは375pxも含んでしまい下段が消えるため、専用の狭いブレークポイントにする */
  @media (max-width: 21.375rem) {
    .header__logo-sub { display: none; }
    .header__inner { padding-inline: 0.9rem; gap: 0.5rem; }
    .header__logo-main { letter-spacing: 0.18em; }
    .header__service { width: 2.1rem; }
    .header__menu summary { width: 2rem; }
  }
</style>
