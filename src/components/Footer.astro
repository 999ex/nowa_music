---
import { activeLinks, CONTACT_EMAIL } from '../lib/links.js';
import { messages } from '../lib/i18n.js';

// tone='light' はトップページ用。朝の明るい色のまま終わらせる
const { lang = 'ja', tone } = Astro.props;
const m = messages[lang].footer;

const links = activeLinks();
const year = new Date().getFullYear();
---

<footer class:list={["footer", tone === "light" && "tone-light footer--light"]}>
  <div class="container">
    <p class="footer__brand">NOWA MUSIC</p>
    <p class="footer__message">{m.message}</p>
    <nav class="footer__links" aria-label={m.links}>
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
      ))}
    </nav>
    {CONTACT_EMAIL && (
      <p class="footer__mail"><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    )}
    <p class="footer__note">{m.analytics}</p>
    <p class="footer__copy">© {year} Nowa Music</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 3rem 4rem;
    text-align: center;
    color: var(--text-dim);
  }
  .footer--light { background: var(--dawn-3); border-top-color: transparent; }
  .footer__brand {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.42em;
    color: var(--text);
    margin: 0;
  }
  .footer__message {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    margin: 1rem 0 2.5rem;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }
  .footer__links a:hover { color: var(--accent); }
  .footer__mail { font-size: 0.8rem; margin: 1.5rem 0 0; }
  .footer__note {
    font-size: 0.68rem;
    line-height: 1.9;
    margin: 2rem 0 0;
  }
  .footer__copy { font-size: 0.7rem; letter-spacing: 0.2em; margin: 2rem 0 0; }
</style>
