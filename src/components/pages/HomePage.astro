---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumShelf from '../AlbumShelf.astro';
import TrackList from '../TrackList.astro';
import heroImage from '../../assets/brand/hero.webp';
import storyImage from '../../assets/brand/story.webp';
import memory01 from '../../assets/brand/memory-01.webp';
import memory02 from '../../assets/brand/memory-02.webp';
import memory03 from '../../assets/brand/memory-03.webp';
import memory04 from '../../assets/brand/memory-04.webp';
import memory05 from '../../assets/brand/memory-05.webp';
import memory06 from '../../assets/brand/memory-06.webp';
import aboutImage from '../../assets/brand/about.webp';
import raw from '../../data/youtube.json';
import { buildCatalog } from '../../lib/catalog.js';
import { activeLinks } from '../../lib/links.js';
import { messages, localePath } from '../../lib/i18n.js';

const { lang = 'ja' } = Astro.props;
const t = messages[lang].home;

// 横長写真はビルド時にwebpの2サイズへ。スマホ(高DPR)でも大きい方が選ばれる
const PHOTO = { format: 'webp', quality: 80, widths: [960, 1672], sizes: '100vw' } as const;

// 背景のスライド。時間でゆっくり入れ替わり、スクロールには連動させない（スクロールを重くしないため）。
// fx = スマホの縦長画面で切り抜くときの横位置。人物の顔が画面の中央付近に来るよう写真ごとに決めている。
const slides = [
  { src: heroImage, fx: 90 },
  { src: storyImage, fx: 60 },
  { src: memory01, fx: 43 },
  { src: memory02, fx: 53 },
  { src: memory03, fx: 41 },
  { src: memory04, fx: 37 },
  { src: memory06, fx: 85 },
];
// 言葉が最後の一文まで来たら、この朝の写真に切り替えて夜を明けさせる
const dawnSlide = { src: memory05, fx: 46 };

const { albums, tracks } = buildCatalog(raw);
const latest = albums[0];
const moreAlbums = albums.slice(1);
const links = activeLinks();
// MUSICセクションから直接飛べる主要な配信先
const streamLinks = links.filter((link) => ['YouTube', 'Spotify', 'Apple Music'].includes(link.label));
const playId = (album) => `${album.kind ?? 'video'}:${album.id}`;
---

<BaseLayout lang={lang} tone="light">
  <main class="home">
    <!-- 01〜03 夜。背景は画面に貼り付いたままスライドし、その上を言葉が普通のスクロールで流れていく -->
    <section class="night" aria-label="NOWA MUSIC">
      <div class="backdrop-track" aria-hidden="true">
      <div class="backdrop">
        {slides.map((slide, i) => (
          <div class:list={['slide', i === 0 && 'is-active']} data-slide style={`--fx: ${slide.fx}%`}>
            <Image src={slide.src} alt="" class="slide__img" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} {...PHOTO} />
          </div>
        ))}
        <div class="slide slide--dawn" data-slide-dawn style={`--fx: ${dawnSlide.fx}%`}>
          <Image src={dawnSlide.src} alt="" class="slide__img" {...PHOTO} />
        </div>
        <div class="backdrop__scrim"></div>
      </div>
      </div>

      <div class="night__content">
        <!-- 01 HERO -->
        <div class="hero">
          <div class="container hero__body">
            <p class="hero__label">NOWA MUSIC</p>
            <h1 class="hero__copy">{t.heroCopy.map((line) => <span>{line}</span>)}</h1>
            <p class="hero__sub">{t.heroSub.map((line) => <span>{line}</span>)}</p>
            <a class="hero__cta" href="#music">
              <span>{t.heroCta}</span>
              <span class="hero__cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <p class="hero__meta" aria-hidden="true">TOKYO · NIGHT · <span id="hero-clock"></span></p>
          <div class="hero__scroll" aria-hidden="true"><span>SCROLL</span></div>
        </div>

        <!-- 02 OUR STORY -->
        <div class="container words reveal stagger">
          <p class="eyebrow line" style="--i: 0">OUR STORY</p>
          <h2 class="words__title line" style="--i: 1">{t.storyTitle.map((line) => <span>{line}</span>)}</h2>
          <p class="words__lines">
            {t.storyLines.map((line, i) => <span class="line" style={`--i: ${i + 2.5}`}>{line}</span>)}
          </p>
        </div>

        <!-- 03 MEMORIES。言葉だけが一文ずつ現れる。最後の一文で背景が朝になる -->
        {t.scenes.map((lines, i) => (
          <div class:list={['container', 'words', 'memory', 'reveal', 'stagger', i === t.scenes.length - 1 && 'memory--last']} data-memory-last={i === t.scenes.length - 1 ? '' : undefined}>
            <p class="memory__copy">
              {lines.map((line, j) => <span class="line" style={`--i: ${j}`}>{line}</span>)}
            </p>
          </div>
        ))}
      </div>
      <div class="night__end" aria-hidden="true"></div>
    </section>

    <!-- 04 MUSIC。ここから朝の明るいトーン。演出より見つけやすさを優先する -->
    {albums.length > 0 && (
      <section class="section music tone-light" id="music">
        <div class="container">
          <div class="section__head reveal">
            <p class="section__label">MUSIC</p>
            <h2 class="section__title">{t.musicTitle}</h2>
            <p class="music__sub">{t.musicSub.map((line) => <span>{line}</span>)}</p>
          </div>

          {latest && (
            <div class="feature reveal">
              <button class="feature__art" type="button" data-play={playId(latest)} data-title={latest.title}>
                {latest.thumbnail && <img src={latest.thumbnail} alt="" loading="lazy" width="480" height="270" />}
                <span class="feature__play" aria-hidden="true">▶</span>
              </button>
              <div class="feature__text">
                <p class="feature__label">{t.latest}</p>
                <h3 class="feature__title">{latest.title}</h3>
                <button class="feature__button" type="button" data-play={playId(latest)} data-title={latest.title}>
                  <span>{t.playLatest}</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          )}

          {moreAlbums.length > 0 && (
            <div class="music__block reveal">
              <h3 class="music__heading">{t.albums}</h3>
              <AlbumShelf albums={moreAlbums} limit={6} lang={lang} />
              <p class="more"><a href={localePath(lang, '/music/')}>{t.allAlbums}</a></p>
            </div>
          )}

          {tracks.length > 0 && (
            <div class="music__block reveal">
              <h3 class="music__heading">{t.singles}</h3>
              <TrackList tracks={tracks} limit={6} />
            </div>
          )}

          {streamLinks.length > 0 && (
            <ul class="streams reveal">
              {streamLinks.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label}<span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <!-- 05 ABOUT -->
    <section class="section about tone-light" id="about">
      <div class="container about__grid">
        <div class="about__art reveal">
          <Image src={aboutImage} alt="Nowa" class="cover" format="webp" quality={80} widths={[560, 1122]} sizes="(min-width: 48rem) 40vw, 100vw" />
        </div>
        <div class="about__text reveal">
          <p class="section__label">ABOUT NOWA MUSIC</p>
          <h2 class="about__copy">{t.aboutCopy.map((line) => <span>{line}</span>)}</h2>
          {t.aboutBody.map((lines) => (
            <p>{lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
          ))}
          <p class="more"><a href={localePath(lang, '/about/')}>{t.readMore}</a></p>
        </div>
      </div>
    </section>

    <!-- 06 LISTEN / FOLLOW -->
    {links.length > 0 && (
      <section class="section listen-section tone-light" id="listen">
        <div class="container reveal">
          <p class="section__label">LISTEN / FOLLOW</p>
          <h2 class="listen-section__title">{t.listenTitle.map((line) => <span>{line}</span>)}</h2>
          <ul class="listen">
            {links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener">
                  <span>{link.label}</span>
                  <span class="listen__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  /* ---------- 共通 ---------- */
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fx, 50%) center;
  }
  @media (min-width: 48rem) {
    .cover { object-position: center 30%; }
  }

  /* 文を1行ずつ浮かび上がらせる。.reveal は表示のきっかけにだけ使う */
  .stagger.reveal { opacity: 1; transform: none; }
  .stagger .line {
    display: block;
    opacity: 0;
    filter: blur(6px);
    transform: translateY(0.8rem);
    transition: opacity 1.6s ease, filter 1.6s ease, transform 1.6s ease;
    transition-delay: calc(var(--i, 0) * 0.45s);
  }
  .stagger.is-visible .line { opacity: 1; filter: none; transform: none; }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.4em;
    color: var(--amber);
    margin: 0 0 1.75rem;
  }

  /* ---------- 01〜03 夜 ---------- */
  .night {
    position: relative;
    background: var(--bg-deep);
    color: var(--on-image);
  }
  /* 背景は夜のセクションの間だけ画面に貼り付く。track がセクション全体を覆い、その中で sticky させる */
  .backdrop-track { position: absolute; inset: 0; }
  .backdrop {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 2.6s ease;
  }
  .slide.is-active { opacity: 1; }
  .slide__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fx, 50%) center;
  }
  @media (min-width: 48rem) {
    .slide__img { object-position: center 30%; }
  }
  /* 表示中の写真だけ、時間をかけてわずかに引いていく（スクロールとは無関係なので軽い） */
  .slide.is-active .slide__img { animation: slow-zoom 10s ease-out both; }
  @keyframes slow-zoom {
    from { transform: scale(1.1); }
    to { transform: scale(1.02); }
  }
  /* 朝。最後の一文に来たら夜の写真を消してこれだけを出す */
  .night.is-dawn .slide { opacity: 0; }
  .night.is-dawn .slide--dawn { opacity: 1; }
  .night.is-dawn .slide--dawn .slide__img { animation: slow-zoom 10s ease-out both; }

  .backdrop__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--scrim-night-soft) 0%, var(--scrim-night) 100%);
    transition: opacity 2.6s ease;
  }
  /* PCは言葉を左に置くので、左側を暗くして右の人物は明るく残す */
  @media (min-width: 48rem) {
    .backdrop__scrim {
      background:
        linear-gradient(180deg, var(--scrim-night-soft) 0%, var(--scrim-night-none) 35%, var(--scrim-night-soft) 100%),
        linear-gradient(90deg, var(--scrim-night) 0%, var(--scrim-night-soft) 50%, var(--scrim-night-none) 75%);
    }
  }
  .night.is-dawn .backdrop__scrim { opacity: 0.55; }

  .night__content { position: relative; }
  .night__content :is(.hero__copy, .hero__sub, .words) { text-shadow: 0 0 2rem var(--scrim-night); }

  /* 夜の終わり。下から朝の色がにじんで MUSIC につながる */
  .night__end {
    position: relative;
    height: 40svh;
    margin-top: -10svh;
    background: linear-gradient(180deg, var(--morning-dawn-fade), var(--dawn-1));
  }

  /* ---------- 01 HERO ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 9rem 6.5rem;
  }
  @media (min-width: 48rem) {
    .hero { align-items: center; padding-block: 8rem; }
  }
  .hero__body > * { animation: rise-in 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .hero__label { animation-delay: 0.9s; }
  .hero__copy { animation-delay: 1.3s; }
  .hero__sub { animation-delay: 1.9s; }
  .hero__cta { animation-delay: 2.4s; }
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(1.25rem); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  .hero__label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.5em;
    color: var(--amber);
    margin: 0 0 1.75rem;
  }
  .hero__copy {
    font-size: clamp(1.45rem, 6.2vw, 3rem);
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0.08em;
    margin: 0 0 1.75rem;
    max-width: 44rem;
  }
  .hero__copy:lang(en) { font-size: clamp(1.45rem, 5vw, 2.6rem); letter-spacing: 0.02em; }
  .hero__copy span,
  .hero__sub span,
  .words__title span,
  .about__copy span,
  .music__sub span,
  .listen-section__title span { display: block; }
  .hero__sub {
    font-size: clamp(0.9rem, 2.6vw, 1.05rem);
    line-height: 2.1;
    color: var(--on-image-dim);
    margin: 0 0 2.75rem;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    min-width: min(15rem, 100%);
    padding: 1rem 1.5rem;
    border: 1px solid var(--on-image-dim);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    transition: border-color 0.5s ease, color 0.5s ease;
  }
  .hero__cta:hover,
  .hero__cta:focus-visible { border-color: var(--amber); color: var(--amber); }
  .hero__cta-arrow { transition: transform 0.5s ease; }
  .hero__cta:hover .hero__cta-arrow { transform: translateX(0.3rem); }

  .hero__meta {
    display: none;
    position: absolute;
    right: 1.25rem;
    bottom: 7rem;
    margin: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: var(--on-image-dim);
  }
  @media (min-width: 48rem) { .hero__meta { display: block; } }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    color: var(--on-image-dim);
  }
  .hero__scroll::after {
    content: "";
    width: 1px;
    height: 3rem;
    background: var(--on-image-dim);
    animation: scroll-hint 2.8s ease-in-out infinite;
  }
  @keyframes scroll-hint {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  /* ---------- 02 OUR STORY / 03 MEMORIES（言葉だけ） ---------- */
  .words {
    min-height: 85svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 4rem;
  }
  .words__title {
    font-size: clamp(1.4rem, 5.4vw, 2.6rem);
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0.08em;
    margin: 0 0 2.5rem;
  }
  .words__lines {
    margin: 0;
    font-size: clamp(0.95rem, 3vw, 1.15rem);
    line-height: 2.5;
    color: var(--on-image-dim);
  }
  .memory { min-height: 70svh; }
  .memory__copy {
    margin: 0;
    font-size: clamp(1.3rem, 5vw, 2.3rem);
    font-weight: 300;
    line-height: 1.9;
    letter-spacing: 0.08em;
  }
  /* 最後の一文は大きく、余韻を長く */
  .memory--last { min-height: 100svh; }
  .memory--last .memory__copy { font-size: clamp(1.7rem, 6vw, 3.2rem); }

  /* ---------- 04 MUSIC ---------- */
  .music {
    background:
      radial-gradient(80% 50% at 80% 0%, var(--amber-glow), transparent 70%),
      linear-gradient(180deg, var(--dawn-1) 0%, var(--dawn-2) 100%);
  }
  .music__sub { margin: 1.5rem 0 0; color: var(--text-dim); line-height: 2.1; }
  .feature {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 5rem;
  }
  @media (min-width: 48rem) {
    .feature { grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: end; }
  }
  .feature__art {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: none;
    overflow: hidden;
    background: var(--bg-deep);
    cursor: pointer;
    box-shadow: 0 2rem 3rem -2rem var(--scrim-night);
  }
  .feature__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .feature__art:hover img,
  .feature__art:focus-visible img { transform: scale(1.03); }
  .feature__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.8rem;
    color: var(--on-image);
    text-shadow: 0 0 1rem var(--scrim-night);
  }
  .feature__label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .feature__title {
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 400;
    line-height: 1.8;
    margin: 0 0 2rem;
    overflow-wrap: anywhere;
  }
  .feature__button {
    display: inline-flex;
    gap: 2rem;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--text);
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background-color 0.4s ease, color 0.4s ease;
  }
  .feature__button:hover,
  .feature__button:focus-visible { background: var(--text); color: var(--dawn-2); }
  .music__block { margin-bottom: 5rem; }
  .music__heading {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin: 0 0 1.75rem;
  }
  .streams {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .streams a {
    display: inline-flex;
    gap: 0.6rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    transition: border-color 0.4s ease, color 0.4s ease;
  }
  .streams a:hover,
  .streams a:focus-visible { border-color: var(--accent); color: var(--accent); }

  /* ---------- 05 ABOUT ---------- */
  .about { background: linear-gradient(180deg, var(--dawn-2) 0%, var(--dawn-2) 100%); }
  .about__grid { display: grid; gap: 3rem; }
  @media (min-width: 48rem) {
    .about__grid { grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: center; }
  }
  .about__art {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    box-shadow: 0 2.5rem 4rem -2.5rem var(--scrim-night);
  }
  .about__art :global(img) { object-position: center 30%; }
  /* 写真と文章を少しずらして浮かび上がらせる */
  .about__text { transition-delay: 0.35s; }
  .about__copy {
    font-size: clamp(1.4rem, 4.4vw, 2.2rem);
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.06em;
    margin: 2rem 0 2.5rem;
  }
  .about__text > p:not(.section__label):not(.more) { margin: 0 0 1.6rem; max-width: 32rem; }

  /* ---------- 06 LISTEN / FOLLOW ---------- */
  .listen-section {
    background: linear-gradient(180deg, var(--dawn-2) 0%, var(--dawn-3) 100%);
    text-align: center;
  }
  .listen-section .section__label { display: inline-block; padding-inline: 1.5rem; }
  .listen-section__title {
    font-size: clamp(1.3rem, 4.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.06em;
    margin: 1.5rem 0 3rem;
  }
  .listen-section .listen { margin-inline: auto; text-align: left; }

  /* ---------- 動きを減らす設定 ---------- */
  @media (prefers-reduced-motion: reduce) {
    .slide, .backdrop__scrim { transition: none; }
    .slide.is-active .slide__img,
    .night.is-dawn .slide--dawn .slide__img,
    .hero__body > *,
    .hero__scroll::after { animation: none; }
    .stagger .line { opacity: 1; filter: none; transform: none; transition: none; }
  }
</style>

<script>
  // 右端の縦書きに閲覧者の現在時刻を出す
  const clock = document.getElementById('hero-clock');
  if (clock) {
    const render = () => {
      const now = new Date();
      clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    };
    render();
    setInterval(render, 30000);
  }

  // 背景のスライド。スクロールとは切り離し、時間だけで入れ替える。
  // 夜のセクションが画面にない間とタブが裏にある間は止める。動きを減らす設定では入れ替えない。
  const night = document.querySelector<HTMLElement>('.night');
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  const lastWords = document.querySelector<HTMLElement>('[data-memory-last]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const INTERVAL = 7000;

  if (night && slides.length > 1) {
    let current = 0;
    let timer = 0;
    let nightVisible = true;
    let dawn = false;

    const show = (index: number) => {
      slides[current].classList.remove('is-active');
      current = index;
      slides[current].classList.add('is-active');
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };
    const start = () => {
      if (timer || reduceMotion || dawn || !nightVisible || document.hidden) return;
      timer = window.setInterval(() => show((current + 1) % slides.length), INTERVAL);
    };

    new IntersectionObserver(([entry]) => {
      nightVisible = entry.isIntersecting;
      nightVisible ? start() : stop();
    }).observe(night);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // 最後の一文が画面の中ほどより上に来たら朝へ。戻れば夜のスライドが再開する。
    // 一気にスクロールしても判定がずれないよう、位置を毎回測る（要素1つだけなので軽い）
    if (lastWords) {
      let ticking = false;
      const check = () => {
        ticking = false;
        const reached = lastWords.getBoundingClientRect().top < window.innerHeight * 0.55;
        if (reached === dawn) return;
        dawn = reached;
        night.classList.toggle('is-dawn', dawn);
        dawn ? stop() : start();
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(check);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      check();
    }

    start();
  }
</script>
