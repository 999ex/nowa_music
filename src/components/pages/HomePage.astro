---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumShelf from '../AlbumShelf.astro';
import TrackList from '../TrackList.astro';
import heroImage from '../../assets/brand/hero.webp';
import storyImage from '../../assets/brand/story.webp';
import memory01 from '../../assets/brand/memory-01.webp';
import memory02 from '../../assets/brand/memory-02.webp';
import memory03 from '../../assets/brand/memory-03.webp';
import memory04 from '../../assets/brand/memory-04.webp';
import memory05 from '../../assets/brand/memory-05.webp';
import aboutImage from '../../assets/brand/about.webp';
import raw from '../../data/youtube.json';
import { buildCatalog } from '../../lib/catalog.js';
import { activeLinks } from '../../lib/links.js';
import { messages, localePath } from '../../lib/i18n.js';

const { lang = 'ja' } = Astro.props;
const t = messages[lang].home;

// 横長写真はビルド時にwebpの2サイズへ。スマホ(高DPR)でも大きい方が選ばれる
const PHOTO = { format: 'webp', quality: 80, widths: [960, 1672], sizes: '100vw' } as const;

// fx = スマホの縦長画面で切り抜くときの横位置。人物の顔が画面の中央付近に来るよう写真ごとに決めている。
// side = PCで言葉を置く側。人物と重ならない方にする。
// motion = シーンごとの動き。後悔 → 懐かしさ → 共感 → 受容 → 優しい記憶 の流れに合わせる。
const scenes = [
  { src: memory01, fx: 68, motion: 'zoom' },
  { src: memory02, fx: 62, motion: 'still' },
  { src: memory03, fx: 37, motion: 'pan', side: 'right' },
  { src: memory04, fx: 50, motion: 'soft' },
  { src: memory05, fx: 70, motion: 'dawn' },
].map((scene, i) => ({ ...scene, copy: t.scenes[i] }));

const { albums, tracks } = buildCatalog(raw);
const latest = albums[0];
const moreAlbums = albums.slice(1);
const links = activeLinks();
// MUSICセクションから直接飛べる主要な配信先
const streamLinks = links.filter((link) => ['YouTube', 'Spotify', 'Apple Music'].includes(link.label));
const playId = (album) => `${album.kind ?? 'video'}:${album.id}`;
---

<BaseLayout lang={lang} tone="light">
  <main class="home">
    <!-- 01 HERO -->
    <section class="hero">
      <div class="hero__media" style="--fx: 77%" aria-hidden="true">
        <div class="hero__shift">
          <div class="hero__zoom">
            <Image src={heroImage} alt="" class="hero__img" loading="eager" fetchpriority="high" {...PHOTO} />
          </div>
        </div>
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="container hero__body">
        <p class="hero__label">NOWA MUSIC</p>
        <h1 class="hero__copy">{t.heroCopy.map((line) => <span>{line}</span>)}</h1>
        <p class="hero__sub">{t.heroSub.map((line) => <span>{line}</span>)}</p>
        <a class="hero__cta" href="#music">
          <span>{t.heroCta}</span>
          <span class="hero__cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero__meta" aria-hidden="true">TOKYO · NIGHT · <span id="hero-clock"></span></p>
      <div class="hero__scroll" aria-hidden="true"><span>SCROLL</span></div>
    </section>

    <!-- 02 OUR STORY -->
    <section class="story" data-parallax>
      <div class="story__media" style="--fx: 82%" aria-hidden="true">
        <div class="parallax">
          <Image src={storyImage} alt="" class="cover" {...PHOTO} />
        </div>
      </div>
      <div class="story__scrim" aria-hidden="true"></div>
      <div class="container story__body reveal stagger">
        <p class="eyebrow line" style="--i: 0">OUR STORY</p>
        <h2 class="story__title line" style="--i: 1">{t.storyTitle.map((line) => <span>{line}</span>)}</h2>
        <p class="story__lines">
          {t.storyLines.map((line, i) => <span class="line" style={`--i: ${i + 2.5}`}>{line}</span>)}
        </p>
      </div>
    </section>

    <!-- 03 MEMORIES。JSが動けばスクロールで1本の映像のようにつながる。動かない環境では写真が縦に並ぶ -->
    <section class="memories" style={`--n: ${scenes.length}`} aria-label="MEMORIES">
      <div class="memories__stage">
        {scenes.map((scene, i) => (
          <div class={`scene scene--${scene.motion} scene--${scene.side ?? "left"}`} data-scene style={`--fx: ${scene.fx}%`}>
            <div class="scene__media" aria-hidden="true">
              <Image src={scene.src} alt="" class="cover scene__img" {...PHOTO} />
            </div>
            <div class="scene__scrim" aria-hidden="true"></div>
            <div class="container scene__body">
              <p class="scene__copy">
                <span class="scene__no" aria-hidden="true">{`SCENE ${String(i + 1).padStart(2, '0')}`}</span>
                {scene.copy.map((line) => <span class="scene__line">{line}</span>)}
              </p>
            </div>
          </div>
        ))}
        <div class="memories__dawn" aria-hidden="true"></div>
      </div>
    </section>

    <!-- 04 MUSIC。ここから朝の明るいトーン。演出より見つけやすさを優先する -->
    {albums.length > 0 && (
      <section class="section music tone-light" id="music">
        <div class="container">
          <div class="section__head reveal">
            <p class="section__label">MUSIC</p>
            <h2 class="section__title">{t.musicTitle}</h2>
            <p class="music__sub">{t.musicSub.map((line) => <span>{line}</span>)}</p>
          </div>

          {latest && (
            <div class="feature reveal">
              <button class="feature__art" type="button" data-play={playId(latest)} data-title={latest.title}>
                {latest.thumbnail && <img src={latest.thumbnail} alt="" loading="lazy" width="480" height="270" />}
                <span class="feature__play" aria-hidden="true">▶</span>
              </button>
              <div class="feature__text">
                <p class="feature__label">{t.latest}</p>
                <h3 class="feature__title">{latest.title}</h3>
                <button class="feature__button" type="button" data-play={playId(latest)} data-title={latest.title}>
                  <span>{t.playLatest}</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          )}

          {moreAlbums.length > 0 && (
            <div class="music__block reveal">
              <h3 class="music__heading">{t.albums}</h3>
              <AlbumShelf albums={moreAlbums} limit={6} lang={lang} />
              <p class="more"><a href={localePath(lang, '/music/')}>{t.allAlbums}</a></p>
            </div>
          )}

          {tracks.length > 0 && (
            <div class="music__block reveal">
              <h3 class="music__heading">{t.singles}</h3>
              <TrackList tracks={tracks} limit={6} />
            </div>
          )}

          {streamLinks.length > 0 && (
            <ul class="streams reveal">
              {streamLinks.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label}<span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <!-- 05 ABOUT -->
    <section class="section about tone-light" id="about">
      <div class="container about__grid">
        <div class="about__art reveal">
          <Image src={aboutImage} alt="Nowa" class="cover" format="webp" quality={80} widths={[560, 1122]} sizes="(min-width: 48rem) 40vw, 100vw" />
        </div>
        <div class="about__text reveal">
          <p class="section__label">ABOUT NOWA MUSIC</p>
          <h2 class="about__copy">{t.aboutCopy.map((line) => <span>{line}</span>)}</h2>
          {t.aboutBody.map((lines) => (
            <p>{lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
          ))}
          <p class="more"><a href={localePath(lang, '/about/')}>{t.readMore}</a></p>
        </div>
      </div>
    </section>

    <!-- 06 LISTEN / FOLLOW -->
    {links.length > 0 && (
      <section class="section listen-section tone-light" id="listen">
        <div class="container reveal">
          <p class="section__label">LISTEN / FOLLOW</p>
          <h2 class="listen-section__title">{t.listenTitle.map((line) => <span>{line}</span>)}</h2>
          <ul class="listen">
            {links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener">
                  <span>{link.label}</span>
                  <span class="listen__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  /* ---------- 共通 ---------- */
  /* 写真を枠いっぱいに敷く。--fx はスマホで切り抜く横位置。PCは中央 */
  .cover,
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fx, 50%) center;
  }
  @media (min-width: 48rem) {
    .cover, .hero__img { object-position: center 30%; }
  }

  /* 文を1行ずつ浮かび上がらせる。.reveal は表示のきっかけにだけ使う */
  .stagger.reveal { opacity: 1; transform: none; }
  .stagger .line {
    display: block;
    opacity: 0;
    filter: blur(6px);
    transform: translateY(0.8rem);
    transition: opacity 1.6s ease, filter 1.6s ease, transform 1.6s ease;
    transition-delay: calc(var(--i, 0) * 0.45s);
  }
  .stagger.is-visible .line { opacity: 1; filter: none; transform: none; }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.4em;
    color: var(--amber);
    margin: 0 0 1.75rem;
  }

  /* パララックスの係数。スマホでは写真を動かさず、フェードだけにする */
  .home {
    --k-hero: 0.35;
    --k-text: -0.18;
    --k-section: 9%;
    --amp: 1;
  }
  @media (max-width: 47.99rem) {
    .home { --k-hero: 0; --k-text: 0; --k-section: 0%; --amp: 0.4; }
  }

  /* ---------- 01 HERO ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 9rem 6.5rem;
    overflow: hidden;
    color: var(--on-image);
  }
  @media (min-width: 48rem) {
    .hero { align-items: center; padding-block: 8rem; }
  }
  .hero__media { position: absolute; inset: 0; overflow: hidden; }
  .hero__shift,
  .hero__zoom { position: absolute; inset: 0; }
  .hero__shift { transform: translate3d(0, calc(var(--hs, 0) * var(--k-hero) * 1px), 0); will-change: transform; }
  /* 開いた瞬間に写真が浮かび、そのまま長い時間をかけてわずかに引いていく */
  .hero__zoom { animation: hero-zoom 14s cubic-bezier(0.2, 0.6, 0.2, 1) both; }
  .hero__img { animation: fade-in 2.6s ease both; }
  @keyframes hero-zoom {
    from { transform: scale(1.12); }
    to { transform: scale(1.02); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--scrim-night-soft) 0%, var(--scrim-night-none) 30%, var(--scrim-night) 72%, var(--bg-deep) 100%);
  }
  /* PCは人物が右、空いた左側にコピーを置く */
  @media (min-width: 48rem) {
    .hero__scrim {
      background:
        linear-gradient(180deg, var(--scrim-night-none) 70%, var(--bg-deep) 100%),
        linear-gradient(90deg, var(--scrim-night) 0%, var(--scrim-night-soft) 45%, var(--scrim-night-none) 70%);
    }
  }
  .hero__body {
    position: relative;
    transform: translate3d(0, calc(var(--hs, 0) * var(--k-text) * 1px), 0);
    opacity: var(--hero-fade, 1);
  }
  .hero__body > * { animation: rise-in 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .hero__label { animation-delay: 0.9s; }
  .hero__copy { animation-delay: 1.3s; }
  .hero__sub { animation-delay: 1.9s; }
  .hero__cta { animation-delay: 2.4s; }
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(1.25rem); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  .hero__label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.5em;
    color: var(--amber);
    margin: 0 0 1.75rem;
  }
  .hero__copy {
    font-size: clamp(1.45rem, 6.2vw, 3rem);
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0.08em;
    margin: 0 0 1.75rem;
    max-width: 44rem;
  }
  .hero__copy:lang(en) { font-size: clamp(1.45rem, 5vw, 2.6rem); letter-spacing: 0.02em; }
  .hero__copy span,
  .hero__sub span,
  .story__title span,
  .about__copy span,
  .music__sub span,
  .listen-section__title span { display: block; }
  .hero__sub {
    font-size: clamp(0.9rem, 2.6vw, 1.05rem);
    line-height: 2.1;
    color: var(--on-image-dim);
    margin: 0 0 2.75rem;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    min-width: min(15rem, 100%);
    padding: 1rem 1.5rem;
    border: 1px solid var(--on-image-dim);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    transition: border-color 0.5s ease, color 0.5s ease, background-color 0.5s ease;
  }
  .hero__cta:hover,
  .hero__cta:focus-visible { border-color: var(--amber); color: var(--amber); }
  .hero__cta-arrow { transition: transform 0.5s ease; }
  .hero__cta:hover .hero__cta-arrow { transform: translateX(0.3rem); }

  .hero__meta {
    display: none;
    position: absolute;
    right: 1.25rem;
    bottom: 7rem;
    margin: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: var(--on-image-dim);
    opacity: var(--hero-fade, 1);
  }
  @media (min-width: 48rem) { .hero__meta { display: block; } }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    color: var(--on-image-dim);
    opacity: var(--hero-fade, 1);
  }
  .hero__scroll::after {
    content: "";
    width: 1px;
    height: 3rem;
    background: var(--on-image-dim);
    animation: scroll-hint 2.8s ease-in-out infinite;
  }
  @keyframes scroll-hint {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  /* ---------- 02 OUR STORY ---------- */
  .story {
    position: relative;
    min-height: 115svh;
    display: flex;
    align-items: center;
    padding-block: 8rem;
    overflow: hidden;
    color: var(--on-image);
    background: var(--bg-deep);
  }
  .story__media { position: absolute; inset: -12% 0; }
  .parallax {
    position: absolute;
    inset: 0;
    transform: translate3d(0, calc(var(--pp, 0) * var(--k-section)), 0);
    will-change: transform;
  }
  .story__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--bg-deep) 0%, var(--scrim-night-none) 22%, var(--scrim-night-none) 78%, var(--bg-deep) 100%),
      linear-gradient(0deg, var(--scrim-night), var(--scrim-night-soft));
  }
  @media (min-width: 48rem) {
    .story__scrim {
      background:
        linear-gradient(180deg, var(--bg-deep) 0%, var(--scrim-night-none) 22%, var(--scrim-night-none) 78%, var(--bg-deep) 100%),
        linear-gradient(90deg, var(--scrim-night) 0%, var(--scrim-night-soft) 50%, var(--scrim-night-none) 75%);
    }
  }
  .story__body { position: relative; }
  .story__title {
    font-size: clamp(1.4rem, 5.4vw, 2.6rem);
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0.08em;
    margin: 0 0 2.5rem;
  }
  .story__lines {
    margin: 0;
    font-size: clamp(0.95rem, 3vw, 1.15rem);
    line-height: 2.5;
    color: var(--on-image-dim);
  }

  /* ---------- 03 MEMORIES ---------- */
  /* 既定（JSなし・動きを減らす設定）は写真を縦に並べるだけ */
  .memories { position: relative; background: var(--bg-deep); color: var(--on-image); }
  .scene {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .scene__media { position: absolute; inset: 0; overflow: hidden; }
  .scene__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--scrim-night-none) 35%, var(--scrim-night) 100%);
  }
  @media (min-width: 48rem) {
    .scene__scrim {
      background:
        linear-gradient(180deg, var(--scrim-night-none) 45%, var(--scrim-night) 100%),
        radial-gradient(120% 90% at 50% 50%, var(--scrim-night-none) 40%, var(--scrim-night-soft) 100%);
    }
  }
  .scene__body { position: relative; padding-block: 6rem 5rem; }
  .scene__copy {
    margin: 0;
    font-size: clamp(1.3rem, 5vw, 2.3rem);
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.08em;
    text-shadow: 0 0 2rem var(--scrim-night);
  }
  .scene__line { display: block; }
  .scene__no {
    display: block;
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    color: var(--amber);
  }
  @media (min-width: 48rem) {
    .scene--right .scene__copy { width: fit-content; margin-left: auto; text-align: right; }
  }
  /* 最後のシーンは朝。言葉を大きく置く。スマホは中央、PCは人物のいない左側 */
  .scene--dawn { text-align: center; }
  @media (min-width: 48rem) {
    .scene--dawn { align-items: center; text-align: left; }
  }
  .scene--dawn .scene__copy { font-size: clamp(1.7rem, 5.4vw, 3rem); }
  .scene--dawn .scene__scrim {
    background: linear-gradient(180deg, var(--scrim-night-none) 40%, var(--scrim-night-soft) 100%);
  }
  .memories__dawn { display: none; }

  /* JSが動く環境：ステージを画面に貼り付け、スクロール量（--u）で写真と言葉を入れ替える */
  .memories.is-cinema { height: calc((var(--n) * 100 + 100) * 1svh); }
  .is-cinema .memories__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .is-cinema .scene {
    position: absolute;
    inset: 0;
    min-height: 0;
    opacity: var(--img-o, 0);
  }
  .is-cinema .scene:first-child { opacity: 1; }
  .is-cinema .scene__copy {
    opacity: var(--cap-o, 0);
    transform: translate3d(0, calc((1 - var(--cap-in, 0)) * 1.5rem), 0);
    filter: blur(calc((1 - var(--cap-in, 0)) * 6px));
  }
  .is-cinema .scene__img { will-change: transform; }
  /* Scene 1 記憶のはじまり：ゆっくり近づく */
  .is-cinema .scene--zoom .scene__img { transform: scale(calc(1.14 - var(--u, 0) * 0.1 * var(--amp))); }
  /* Scene 2 言えなかった想い：写真はほぼ止め、言葉だけが流れていく */
  .is-cinema .scene--still .scene__img { transform: scale(1.04); }
  .is-cinema .scene--still .scene__copy {
    transform: translate3d(0, calc((0.45 - var(--u, 0)) * 28svh * var(--amp)), 0);
  }
  /* Scene 3 思い出の街：街をたどるように横へ流れる */
  .is-cinema .scene--pan .scene__img {
    transform: scale(1.12) translate3d(calc((0.5 - var(--u, 0)) * 5% * var(--amp)), 0, 0);
  }
  /* Scene 4 受け止める時間：動きを抑え、光を少しずつ柔らかく明るく */
  .is-cinema .scene--soft .scene__img {
    transform: scale(calc(1.06 - var(--u, 0) * 0.03));
    filter: brightness(calc(0.82 + var(--u, 0) * 0.22)) saturate(calc(0.9 + var(--u, 0) * 0.1));
  }
  /* Scene 5 優しい記憶へ：夜の色が抜けて、朝の光が満ちる */
  .is-cinema .scene--dawn .scene__img {
    transform: scale(calc(1.1 - var(--u, 0) * 0.08));
    filter: brightness(calc(0.75 + var(--u, 0) * 0.3));
  }
  .is-cinema .memories__dawn {
    display: block;
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(180deg, var(--morning-dawn-fade), var(--dawn-1));
    opacity: var(--end, 0);
    pointer-events: none;
  }

  /* ---------- 04 MUSIC ---------- */
  .music {
    background:
      radial-gradient(80% 50% at 80% 0%, var(--amber-glow), transparent 70%),
      linear-gradient(180deg, var(--dawn-1) 0%, var(--dawn-2) 100%);
  }
  .music__sub { margin: 1.5rem 0 0; color: var(--text-dim); line-height: 2.1; }
  .feature {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 5rem;
  }
  @media (min-width: 48rem) {
    .feature { grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: end; }
  }
  .feature__art {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: none;
    overflow: hidden;
    background: var(--bg-deep);
    cursor: pointer;
    box-shadow: 0 2rem 3rem -2rem var(--scrim-night);
  }
  .feature__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .feature__art:hover img,
  .feature__art:focus-visible img { transform: scale(1.03); }
  .feature__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.8rem;
    color: var(--on-image);
    text-shadow: 0 0 1rem var(--scrim-night);
  }
  .feature__label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .feature__title {
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    font-weight: 400;
    line-height: 1.8;
    margin: 0 0 2rem;
    overflow-wrap: anywhere;
  }
  .feature__button {
    display: inline-flex;
    gap: 2rem;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--text);
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background-color 0.4s ease, color 0.4s ease;
  }
  .feature__button:hover,
  .feature__button:focus-visible { background: var(--text); color: var(--dawn-2); }
  .music__block { margin-bottom: 5rem; }
  .music__heading {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin: 0 0 1.75rem;
  }
  .streams {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .streams a {
    display: inline-flex;
    gap: 0.6rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    transition: border-color 0.4s ease, color 0.4s ease;
  }
  .streams a:hover,
  .streams a:focus-visible { border-color: var(--accent); color: var(--accent); }

  /* ---------- 05 ABOUT ---------- */
  .about { background: linear-gradient(180deg, var(--dawn-2) 0%, var(--dawn-2) 100%); }
  .about__grid { display: grid; gap: 3rem; }
  @media (min-width: 48rem) {
    .about__grid { grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: center; }
  }
  .about__art {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    box-shadow: 0 2.5rem 4rem -2.5rem var(--scrim-night);
  }
  .about__art :global(img) { object-position: center 30%; }
  /* 写真と文章を少しずらして浮かび上がらせる */
  .about__text { transition-delay: 0.35s; }
  .about__copy {
    font-size: clamp(1.4rem, 4.4vw, 2.2rem);
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.06em;
    margin: 2rem 0 2.5rem;
  }
  .about__text > p:not(.section__label):not(.more) { margin: 0 0 1.6rem; max-width: 32rem; }

  /* ---------- 06 LISTEN / FOLLOW ---------- */
  .listen-section {
    background: linear-gradient(180deg, var(--dawn-2) 0%, var(--dawn-3) 100%);
    text-align: center;
  }
  .listen-section .section__label { display: inline-block; padding-inline: 1.5rem; }
  .listen-section__title {
    font-size: clamp(1.3rem, 4.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.06em;
    margin: 1.5rem 0 3rem;
  }
  .listen-section .listen { margin-inline: auto; text-align: left; }

  /* ---------- 動きを減らす設定 ---------- */
  @media (prefers-reduced-motion: reduce) {
    .hero__shift, .hero__body, .parallax { transform: none; }
    .hero__zoom, .hero__img, .hero__body > *, .hero__scroll::after { animation: none; }
    .stagger .line { opacity: 1; filter: none; transform: none; transition: none; }
  }
</style>

<script>
  // 右端の縦書きに閲覧者の現在時刻を出す
  const clock = document.getElementById('hero-clock');
  if (clock) {
    const render = () => {
      const now = new Date();
      clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    };
    render();
    setInterval(render, 30000);
  }

  // スクロール量を CSS 変数に流すだけにして、動きの大きさは CSS 側で決める。
  // 動きを減らす設定の人には何もしない（CSS の既定値で静止した表示になる）。
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const hero = document.querySelector<HTMLElement>('.hero');
  const parallaxSections = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const memories = document.querySelector<HTMLElement>('.memories');
  const scenes = [...document.querySelectorAll<HTMLElement>('[data-scene]')];

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    memories?.classList.add('is-cinema');

    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const vh = window.innerHeight;

      if (hero && y <= hero.offsetHeight) {
        hero.style.setProperty('--hs', String(y));
        hero.style.setProperty('--hero-fade', String(1 - clamp01(y / (hero.offsetHeight * 0.65))));
      }

      // セクションの中心が画面中央より下なら負、上なら正（-1〜1）
      for (const section of parallaxSections) {
        const rect = section.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) continue;
        const pp = (vh / 2 - (rect.top + rect.height / 2)) / (vh / 2 + rect.height / 2);
        section.style.setProperty('--pp', pp.toFixed(4));
      }

      if (memories && scenes.length) {
        const rect = memories.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < vh) {
          // 0〜シーン数。整数部が今のシーン、小数部がそのシーンの進み具合
          const distance = Math.max(1, memories.offsetHeight - vh);
          const p = clamp01(-rect.top / distance) * scenes.length;
          scenes.forEach((scene, i) => {
            const u = p - i;
            const last = i === scenes.length - 1;
            // 次の写真は、前のシーンの終わり 30% をかけて重なるように現れる
            const imgO = i === 0 ? 1 : clamp01((u + 0.3) / 0.3);
            const capIn = clamp01((u - 0.05) / 0.25);
            const capOut = last ? 1 : clamp01((0.82 - u) / 0.14);
            scene.style.setProperty('--u', Math.min(1.3, Math.max(-0.3, u)).toFixed(4));
            scene.style.setProperty('--img-o', imgO.toFixed(3));
            scene.style.setProperty('--cap-in', capIn.toFixed(3));
            scene.style.setProperty('--cap-o', Math.min(capIn, capOut).toFixed(3));
          });
          // 最後のシーンの後半で、下から朝の色がにじむ
          memories.style.setProperty('--end', clamp01((p - (scenes.length - 0.45)) / 0.45).toFixed(3));
        }
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
